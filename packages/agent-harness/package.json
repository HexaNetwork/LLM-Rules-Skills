{
  "name": "@hexanetwork/agent-harness",
  "version": "1.0.0",
  "description": "Container-only, durable idea-to-pull-request orchestration",
  "type": "module",
  "bin": {
    "agent-harness": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docker",
    "templates",
    "ui"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:docker": "vitest run --config vitest.docker.config.ts --passWithNoTests",
    "test:release": "npm run test:run && node ./scripts/test-release.mjs",
    "test:run": "npm run test:unit && npm run test:integration",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@cursor/sdk": "~1.0.27",
    "commander": "^14.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
