{
  "name": "@hexanetwork/agent-harness",
  "version": "0.4.0",
  "description": "Durable idea-to-feature orchestration with a centralized local dashboard",
  "type": "module",
  "bin": {
    "agent-harness": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docker",
    "templates"
  ],
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "sync-guidance": "node ./scripts/sync-guidance-templates.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "test:run": "npm run test:unit && npm run test:integration",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@cursor/sdk": "~1.0.27",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "commander": "^14.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
